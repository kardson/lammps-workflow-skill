{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_sha256",
          "engine_id",
          "scenario",
          "dimension",
          "status",
          "evidence"
        ],
        "properties": {
          "model_sha256": {
            "type": "string",
            "minLength": 1
          },
          "engine_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "enum": [
              "installation",
              "numerical",
              "mpi",
              "deposition",
              "restart",
              "physical_accuracy"
            ]
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "UNVERIFIED",
              "PARTIAL"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "precision": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "interface": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
