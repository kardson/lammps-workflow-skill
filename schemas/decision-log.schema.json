{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "plan",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "decision_log"
    },
    "plan": {
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "summary",
          "status",
          "source",
          "related_fields",
          "blocks",
          "release_condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "DECISION",
              "ASSUMPTION",
              "QUESTION",
              "ISSUE"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "INVESTIGATING",
              "FIX_PROPOSED",
              "RESOLVED",
              "SUPERSEDED"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "related_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "release_condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "selected_fix": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "regression_scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "RESOLVED"
                }
              }
            },
            "then": {
              "required": [
                "resolution",
                "evidence"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ISSUE"
                },
                "status": {
                  "const": "RESOLVED"
                }
              }
            },
            "then": {
              "required": [
                "selected_fix",
                "verification",
                "regression_scope"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "OPEN",
                    "INVESTIGATING",
                    "FIX_PROPOSED"
                  ]
                },
                "blocks": {
                  "minItems": 1
                }
              }
            },
            "then": {
              "properties": {
                "release_condition": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
